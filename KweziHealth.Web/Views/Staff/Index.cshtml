@model IEnumerable<KweziHealth.Web.Models.StaffMember>

@{
    ViewData["Title"] = "Staff Directory";
}

<!-- Header Section -->
<div class="d-flex justify-content-between align-items-end mb-4 mt-3">
    <div>
        <h2 class="fw-bold mb-1" style="color: #0d3b66;">Staff Directory</h2>
        <p class="text-muted mb-0">Manage KweziHealth enterprise personnel records</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-4 rounded-pill">
        <i class="bi bi-person-plus-fill me-2"></i> Register New Staff
    </a>
</div>

<!-- Dashboard Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="bg-light text-muted" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                <tr>
                    <th class="ps-4 py-3 fw-semibold border-bottom-0">Employee</th>
                    <th class="py-3 fw-semibold border-bottom-0">Contact Info</th>
                    <th class="py-3 fw-semibold border-bottom-0">Role</th>
                    <th class="py-3 fw-semibold border-bottom-0">Department</th>
                    <th class="text-end pe-4 py-3 fw-semibold border-bottom-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-5">
                        <div class="py-5">
                            <i class="bi bi-people text-muted opacity-50" style="font-size: 3.5rem;"></i>
                            <h5 class="mt-3 fw-bold text-dark">No Staff Records Found</h5>
                            <p class="text-muted">There are currently no employees registered in the system.</p>
                            <a asp-action="Create" class="btn btn-outline-primary mt-2 rounded-pill">Get Started</a>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model) {
                    <tr class="border-bottom">
                        <!-- Avatar and Name Column -->
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 45px; height: 45px;">
                                    <!-- Auto-generate an avatar from the first letter of the name -->
                                    <span class="fw-bold fs-5">@(string.IsNullOrEmpty(item.FullName) ? "U" : item.FullName.Substring(0,1).ToUpper())</span>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark fs-6 mb-1">@item.FullName</div>
                                    <div class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25" style="font-family: monospace;">EMP-@item.StaffId.ToString("D4")</div>
                                </div>
                            </div>
                        </td>
                        
                        <!-- Email Column -->
                        <td class="py-3">
                            <a href="mailto:@item.Email" class="text-decoration-none text-muted d-flex align-items-center hover-primary">
                                <i class="bi bi-envelope-at me-2 text-secondary opacity-75"></i> @item.Email
                            </a>
                        </td>
                        
                        <!-- Position/Role Column -->
                        <td class="py-3">
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 fw-normal">
                                @item.Position
                            </span>
                        </td>
                        
                        <!-- Unit Column -->
                        <td class="py-3 text-muted">
                            <i class="bi bi-buildings me-2 text-secondary opacity-75"></i> @item.Unit
                        </td>
                        
                        <!-- Actions Column -->
                        <td class="text-end pe-4 py-3">
                            <div class="btn-group shadow-sm border rounded-3">
                                <a asp-action="Edit" asp-route-id="@item.StaffId" class="btn btn-sm btn-light text-primary px-3" title="Edit Record">
                                    <i class="bi bi-pencil-square"></i>
                                </a> 
                                <a asp-action="Delete" asp-route-id="@item.StaffId" class="btn btn-sm btn-light text-danger px-3" title="Revoke Access">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
@model KweziHealth.Web.Models.StaffMember

@{
    ViewData["Title"] = "Revoke Staff Access";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-lg-7 col-xl-6">
        
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Staff Directory</a></li>
                <li class="breadcrumb-item active fw-bold text-danger" aria-current="page">Revoke Access</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <div class="d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-danger">Revoke System Access</h3>
                        <p class="text-muted mb-0 small">Please confirm the removal of this employee record.</p>
                    </div>
                </div>
            </div>
            
            <div class="card-body p-4 bg-white">
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 rounded-3 mb-4">
                    <i class="bi bi-shield-exclamation me-2 fw-bold"></i>
                    <strong>Warning:</strong> This action will permanently remove the employee from the ESOP directory. All associated system access will be revoked immediately. This action cannot be undone.
                </div>
                
                <div class="bg-light rounded-4 p-4 mb-4 border border-light shadow-sm">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Employee ID</div>
                        <div class="col-sm-8 fw-bold text-dark" style="font-family: monospace; letter-spacing: 1px;">EMP-@Model.StaffId.ToString("D4")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Full Name</div>
                        <div class="col-sm-8 fw-bold text-dark">@Model.FullName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Email</div>
                        <div class="col-sm-8 text-primary"><i class="bi bi-envelope-at me-2 text-secondary opacity-75"></i>@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Position</div>
                        <div class="col-sm-8">
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1 fw-normal">
                                @Model.Position
                            </span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Department</div>
                        <div class="col-sm-8 text-dark"><i class="bi bi-buildings me-2 text-secondary opacity-75"></i>@Model.Unit</div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="StaffId" />
                    
                    <hr class="text-muted opacity-25 my-4" />
                    
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-action="Index" class="btn btn-light border px-4 rounded-pill fw-semibold text-muted hover-primary">Abort</a>
                        <button type="submit" class="btn btn-danger px-4 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-trash3-fill me-1"></i> Confirm Revocation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<SystemAdmin> SignInManager
@inject UserManager<SystemAdmin> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <!-- Replaced the Identity Account Manage link with a simple text span -->
        <span class="nav-link text-dark">Hello @User.Identity?.Name!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Access" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Access" asp-action="Login">Login</a>
    </li>
}
</ul>

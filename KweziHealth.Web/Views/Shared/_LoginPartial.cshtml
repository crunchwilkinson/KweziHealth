@using Microsoft.AspNetCore.Identity
@inject SignInManager<SystemAdmin> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item d-flex align-items-center">
        <span class="nav-link text-white me-3">
            <i class="bi bi-person-circle me-1"></i> Hello, @User.Identity?.Name
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Access" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-light btn-sm mt-1">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white" asp-area="" asp-controller="Access" asp-action="Login">
            <i class="bi bi-shield-lock me-1"></i> Admin Login
        </a>
    </li>
}
</ul>